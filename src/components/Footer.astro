---
const year = new Date().getFullYear();
---

<footer class="relative bg-plum-950 pt-20 pb-8 grain overflow-hidden">
  <div class="container-wide relative z-10">
    <div class="grid md:grid-cols-[1.2fr_0.8fr_0.8fr_0.8fr] gap-10 pb-14 border-b border-cream/10">
      <div>
        <a href="#top" class="font-display text-3xl text-gold-light">AMG</a>
        <p class="mt-4 text-plum-300 text-sm max-w-xs leading-relaxed">
          Atlanta Meets Groomers. Full-service pet grooming, creative styling, and a boutique
          pet shop built around personalized, calming care.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://www.instagram.com/amgkennelatl/"
            target="_blank"
            rel="noreferrer"
            class="w-10 h-10 rounded-full bg-plum-800 hover:bg-gold hover:text-ink flex items-center justify-center transition-colors text-cream"
            aria-label="Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a
            href="#shop"
            class="w-10 h-10 rounded-full bg-plum-800 hover:bg-gold hover:text-ink flex items-center justify-center transition-colors text-cream"
            aria-label="Shop"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="font-display text-lg text-cream mb-4">Explore</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#story" class="text-plum-300 hover:text-gold-light transition-colors">Our Story</a></li>
          <li><a href="#services" class="text-plum-300 hover:text-gold-light transition-colors">Services</a></li>
          <li><a href="#shop" class="text-plum-300 hover:text-gold-light transition-colors">Shop</a></li>
          <li><a href="#gallery" class="text-plum-300 hover:text-gold-light transition-colors">Gallery</a></li>
          <li><a href="#reviews" class="text-plum-300 hover:text-gold-light transition-colors">Reviews</a></li>
        </ul>
      </div>

      <div>
        <p class="font-display text-lg text-cream mb-4">Visit</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#visit" class="text-plum-300 hover:text-gold-light transition-colors">Hours &amp; Contact</a></li>
          <li><a href="#book" class="text-plum-300 hover:text-gold-light transition-colors">Book Now</a></li>
          <li><a href="tel:+14045730317" class="text-plum-300 hover:text-gold-light transition-colors">(404) 573-0317</a></li>
        </ul>
      </div>

      <div>
        <p class="font-display text-lg text-cream mb-4">Boutique</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#shop" class="text-plum-300 hover:text-gold-light transition-colors">Boutique Picks</a></li>
          <li><span class="text-plum-300">Yorkie Litters</span></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-plum-400 text-xs">&copy; {year} AMG Kennel Atlanta. All rights reserved.</p>
      <p class="text-plum-400 text-xs flex items-center gap-1.5">
        Made with
        <svg viewBox="0 0 64 64" fill="currentColor" class="text-gold-light" width="14" height="14" aria-hidden="true">
          <ellipse cx="32" cy="41" rx="16" ry="13" />
          <ellipse cx="13" cy="21" rx="7.2" ry="9.2" transform="rotate(-24 13 21)" />
          <ellipse cx="26.5" cy="9.5" rx="7.6" ry="9.6" transform="rotate(-7 26.5 9.5)" />
          <ellipse cx="41" cy="9.5" rx="7.6" ry="9.6" transform="rotate(7 41 9.5)" />
          <ellipse cx="52.5" cy="21" rx="7.2" ry="9.2" transform="rotate(24 52.5 21)" />
        </svg>
        in Atlanta, GA
      </p>
    </div>
  </div>
</footer>
